# ===== إعدادات Supabase =====
# انسخ هذا الملف إلى .env واملأ القيم من مشروع Supabase الخاص بك.
# (Project Settings → API)

# عنوان مشروع Supabase
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# المفتاح العام (anon public key) — آمن للاستخدام في المتصفح مع تفعيل RLS
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ملاحظة: إن تُركت هذه القيم فارغة، يعمل التطبيق في «وضع المعاينة»
# باستخدام بيانات تجريبية محليًا (دون اتصال بقاعدة بيانات حقيقية).
